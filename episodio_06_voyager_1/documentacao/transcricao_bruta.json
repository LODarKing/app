{
 "arquivo": "narracao_original/Voyager .mp3",
 "dur": 65.306,
 "modelo": "faster-whisper large-v3 int8",
 "segmentos": [
  {
   "ini": 0.0,
   "fim": 4.16,
   "texto": "Imagine enviar uma mensagem e precisar esperar dois dias por uma resposta."
  },
  {
   "ini": 5.18,
   "fim": 8.1,
   "texto": "Não é ficção científica. É o que acontece com a Voyager 1."
  },
  {
   "ini": 8.3,
   "fim": 12.28,
   "texto": "Em 18 de novembro de 2026, ela alcançou um marco histórico."
  },
  {
   "ini": 12.36,
   "fim": 17.06,
   "texto": "Tornou-se o primeiro objeto construído pela humanidade a chegar a um dia-luz de distância da Terra."
  },
  {
   "ini": 17.24,
   "fim": 19.8,
   "texto": "São quase 26 bilhões de quilômetros."
  },
  {
   "ini": 20.12,
   "fim": 25.4,
   "texto": "Mesmo viajando à velocidade da luz, um sinal de rádio leva cerca de 24 horas para chegar até ela."
  },
  {
   "ini": 25.4,
   "fim": 30.12,
   "texto": "E se a nave respondesse imediatamente, seriam mais 24 horas para a resposta voltar."
  },
  {
   "ini": 30.54,
   "fim": 34.08,
   "texto": "Mas, justamente neste momento histórico, algo preocupa a NASA."
  },
  {
   "ini": 34.3,
   "fim": 39.56,
   "texto": "Desde 14 de novembro, a sonda deixou de transmitir normalmente seus dados científicos e de engenharia."
  },
  {
   "ini": 39.66,
   "fim": 43.66,
   "texto": "O sinal de rádio ainda chega à Terra, mas os engenheiros investigam o problema."
  },
  {
   "ini": 44.18,
   "fim": 51.38,
   "texto": "Lançada em 1977, a Voyager 1 passou por Júpiter, Saturno, e em 2012 entrou no espaço interestelar."
  },
  {
   "ini": 51.52,
   "fim": 55.38,
   "texto": "Quase 50 anos depois, essa pequena máquina continua atravessando."
  },
  {
   "ini": 55.4,
   "fim": 61.26,
   "texto": "Atravessando a imensidão do espaço, tão distante que até a própria luz precisa de um dia inteiro para alcançá-la."
  },
  {
   "ini": 61.52,
   "fim": 65.08,
   "texto": "Além do visível, o extraordinário está nos detalhes."
  }
 ],
