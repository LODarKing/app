 "frases": [
  {
   "n": 1,
   "texto": "Imagine enviar uma mensagem e precisar esperar dois dias por uma resposta.",
   "nivel_db": -20.9,
   "f0_mediana_hz": 150.0,
   "ini": 0.06,
   "fim": 4.4
  },
  {
   "n": 2,
   "texto": "Não é ficção científica.",
   "nivel_db": -22.5,
   "f0_mediana_hz": 98.4,
   "ini": 5.2,
   "fim": 6.401
  },
  {
   "n": 3,
   "texto": "É o que acontece com a Voyager 1.",
   "nivel_db": -21.7,
   "f0_mediana_hz": 102.8,
   "ini": 6.721,
   "fim": 8.181
  },
  {
   "n": 4,
   "texto": "Em 18 de novembro de 2026, ela alcançou um marco histórico.",
   "nivel_db": -21.1,
   "f0_mediana_hz": 123.7,
   "ini": 8.741,
   "fim": 12.321
  },
  {
   "n": 5,
   "texto": "Tornou-se o primeiro objeto construído pela humanidade a chegar a um dia-luz de distância da Terra.",
   "nivel_db": -20.1,
   "f0_mediana_hz": 142.4,
   "ini": 12.581,
   "fim": 17.182
  },
  {
   "n": 6,
   "texto": "São quase 26 bilhões de quilômetros.",
   "nivel_db": -21.1,
   "f0_mediana_hz": 121.5,
   "ini": 17.622,
   "fim": 20.042
  },
  {
   "n": 7,
   "texto": "Mesmo viajando à velocidade da luz, um sinal de rádio leva cerca de 24 horas para chegar até ela.",
   "nivel_db": -20.9,
   "f0_mediana_hz": 135.2,
   "ini": 20.442,
   "fim": 25.442
  },
  {
   "n": 8,
   "texto": "E se a nave respondesse imediatamente, seriam mais 24 horas para a resposta voltar.",
   "nivel_db": -21.6,
   "f0_mediana_hz": 126.2,
   "ini": 25.722,
   "fim": 30.403
  },
  {
   "n": 9,
   "texto": "Mas, justamente neste momento histórico, algo preocupa a NASA.",
   "nivel_db": -21.9,
   "f0_mediana_hz": 159.0,
   "ini": 31.043,
   "fim": 34.223
  },
  {
   "n": 10,
   "texto": "Desde 14 de novembro, a sonda deixou de transmitir normalmente seus dados científicos e de engenharia.",
   "nivel_db": -21.8,
   "f0_mediana_hz": 131.4,
   "ini": 34.563,
   "fim": 39.624
  },
  {
   "n": 11,
   "texto": "O sinal de rádio ainda chega à Terra, mas os engenheiros investigam o problema.",
   "nivel_db": -21.7,
   "f0_mediana_hz": 115.0,
   "ini": 39.984,
   "fim": 43.824
  },
  {
   "n": 12,
   "texto": "Lançada em 1977, a Voyager 1 passou por Júpiter, Saturno, e em 2012 entrou no espaço interestelar.",
   "nivel_db": -21.4,
   "f0_mediana_hz": 151.8,
   "ini": 44.464,
   "fim": 51.465
  },
  {
   "n": 13,
   "texto": "Quase 50 anos depois, essa pequena máquina continua atravessando a imensidão do espaço, tão distante que até a própria luz precisa de um dia inteiro para alcançá-la.",
   "nivel_db": -25.0,
   "f0_mediana_hz": 114.4,
   "ini": 51.805,
   "fim": 61.286
  },
  {
   "n": 14,
   "texto": "Além do visível, o extraordinário está nos detalhes.",
   "nivel_db": -25.4,
   "f0_mediana_hz": 91.0,
   "ini": 61.926,
   "fim": 65.166
  }
 ],
